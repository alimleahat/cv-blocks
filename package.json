{
  "name": "blokk",
  "productName": "Blokk",
  "version": "2.0.0",
  "description": "Drag-and-drop CV builder: snap blocks in and out, auto-fit to one page, export to PDF.",
  "author": "Ali Mleahat",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.alimleahat.cvblocks",
    "productName": "Blokk",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "fonts/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist.noindex"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "title": "Blokk",
      "artifactName": "Blokk-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-win.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Blokk",
      "artifactName": "Blokk-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "alimleahat",
      "repo": "cv-blocks",
      "releaseType": "draft"
    },
    "afterPack": "build/adhoc-sign.js"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alimleahat/cv-blocks.git"
  }
}
